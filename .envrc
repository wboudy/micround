# .envrc - Direnv configuration for automatic CI-first environment activation
#
# If you use direnv (https://direnv.net/), this file will automatically
# source agent-env.sh when entering the project directory.
#
# Setup:
#   1. Install direnv: brew install direnv (macOS) or apt install direnv (Linux)
#   2. Hook into shell: eval "$(direnv hook bash)" in ~/.bashrc
#   3. Allow this directory: direnv allow
#
# For agents: This enables automatic cargo-guard activation

# Only activate for agents (check if CLAUDE_AGENT is already set or if we detect agent context)
if [ "${CLAUDE_AGENT:-}" = "true" ] || [ -n "${ANTHROPIC_API_KEY:-}" ] || [ -n "${CLAUDE_CODE:-}" ]; then
  # Source the agent environment
  if [ -f "scripts/agent-env.sh" ]; then
    # shellcheck source=scripts/agent-env.sh
    source "scripts/agent-env.sh"
  fi
fi
